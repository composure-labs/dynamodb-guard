{
  "name": "@composure-labs/dynamodb-guard",
  "version": "0.0.0",
  "description": "Catch DynamoDB expression mistakes before deploy: reserved words, unaliased names and unused placeholders, checked at synth (CDK), in unit tests (mocked SDK clients) and in lint (ESLint).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/composure-labs/dynamodb-guard.git"
  },
  "bugs": {
    "url": "https://github.com/composure-labs/dynamodb-guard/issues"
  },
  "homepage": "https://github.com/composure-labs/dynamodb-guard#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "composurecdk",
    "composurecdk-guard",
    "aws",
    "dynamodb",
    "reserved-words",
    "aws-cdk",
    "step-functions",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "testing",
    "aws-sdk-client-mock"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tshy",
    "pack": "npm pack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:exports": "attw *.tgz && publint run *.tgz",
    "check:entries": "node scripts/check-entries.mjs",
    "check:peers": "node scripts/check-peer-mirror.mjs",
    "check:consumer": "node scripts/consumer-smoke.mjs",
    "corpus:record": "node scripts/record-corpus.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run check:peers && npm run build && npm run pack && npm run check:exports && npm run check:entries && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yaml,yml}": "prettier --write",
    ".github/workflows/*.yml": "actionlint"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./cdk": "./src/cdk.ts",
      "./testing": "./src/testing.ts",
      "./eslint": "./src/eslint.ts"
    }
  },
  "typesVersions": {
    "*": {
      "cdk": [
        "./dist/commonjs/cdk.d.ts"
      ],
      "testing": [
        "./dist/commonjs/testing.d.ts"
      ],
      "eslint": [
        "./dist/commonjs/eslint.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.93.0",
    "constructs": "^10.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@composurecdk/eslint-plugin": "^0.11.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@kjanat/actionlint": "1.17.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "aws-cdk-lib": "^2.93.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "semver": "^7.8.5",
    "tshy": "^4.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/esm/cdk.d.ts",
        "default": "./dist/esm/cdk.js"
      },
      "require": {
        "types": "./dist/commonjs/cdk.d.ts",
        "default": "./dist/commonjs/cdk.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/commonjs/testing.d.ts",
        "default": "./dist/commonjs/testing.js"
      }
    },
    "./eslint": {
      "import": {
        "types": "./dist/esm/eslint.d.ts",
        "default": "./dist/esm/eslint.js"
      },
      "require": {
        "types": "./dist/commonjs/eslint.d.ts",
        "default": "./dist/commonjs/eslint.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
